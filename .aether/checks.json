{
  "version": 2,
  "checks": [
    {
      "id": "python-tests",
      "name": "Python Tests",
      "kind": "test",
      "command": "V=\"$(dirname \"$(git rev-parse --git-common-dir)\")/.venv/bin/pytest\"; if [ -x \"$V\" ]; then \"$V\"; else python3 -m pytest; fi",
      "enabled": true,
      "scope": "repo"
    },
    {
      "id": "web-ui-tests",
      "name": "Web UI tests",
      "kind": "test",
      "command": "npm --prefix web run test",
      "enabled": true,
      "scope": "repo"
    },
    {
      "id": "agent-tests",
      "name": "Agent tests",
      "kind": "test",
      "command": "npm --prefix agent run test",
      "enabled": true,
      "scope": "repo"
    }
  ]
}
