  "connections": [
    {
      "from": "web-ui",
      "protocol": "HTTP/REST",
      "to": "api"
    },
    {
      "from": "api",
      "protocol": "in-process",
      "to": "truth-store"
    },
    {
      "from": "api",
      "protocol": "in-process",
      "to": "tailor-engine"
    },
    {
      "from": "api",
      "protocol": "in-process",
      "to": "guardrail-validator"
    },
    {
      "from": "api",
      "protocol": "in-process",
      "to": "renderer"
