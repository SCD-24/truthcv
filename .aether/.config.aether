                  "flags": "",
                  "name": "attachments",
                  "notes": "The files actually uploaded with the application.",
                  "type": "list<{kind,path}>"
                },
                {
                  "flags": "",
                  "name": "screening",
                  "notes": "The pre-application filter verdicts recorded against this application.",
                  "type": "{entity, remote, salary, language, role_type, glassdoor}"
                }
              ]
            },
            "h": 240,
