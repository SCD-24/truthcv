{
  "version": 1,
  "setup": [
    {
      "id": "pull",
      "name": "Pull images",
      "command": "docker compose pull",
      "enabled": true
    },
    {
      "id": "agent-install",
      "name": "Agent install",
      "command": "cd agent && npm ci",
      "enabled": true
    },
    {
      "id": "web-install",
      "name": "Web install",
      "command": "cd web && npm ci",
      "enabled": true
    }
  ],
  "run": [
    {
      "id": "up",
      "name": "Start the stack",
      "command": "docker compose up",
      "enabled": true
    }
  ]
}
