{
  "version": 2,
  "checks": [
    {
      "id": "lint",
      "name": "Typecheck (web + agent)",
      "kind": "lint",
      "command": "bash scripts/check.sh lint",
      "enabled": true,
      "scope": "repo"
    },
    {
      "id": "test",
      "name": "Tests (python + web + agent)",
      "kind": "test",
      "command": "bash scripts/check.sh test",
      "enabled": true,
      "scope": "repo"
    },
    {
      "id": "python-tests",
      "name": "Python Tests",
      "kind": "test",
      "command": "bash scripts/check.sh test-python",
      "enabled": true,
      "scope": "repo"
    },
    {
      "id": "web-ui-tests",
      "name": "Web UI tests",
      "kind": "test",
      "command": "bash scripts/check.sh test-web",
      "enabled": true,
      "scope": "repo"
    },
    {
      "id": "agent-tests",
      "name": "Agent tests",
      "kind": "test",
      "command": "bash scripts/check.sh test-agent",
      "enabled": true,
      "scope": "repo"
    }
  ]
}
