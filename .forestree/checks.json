{
  "version": 2,
  "checks": [
    {
      "id": "lint",
      "name": "ESLint (web)",
      "kind": "lint",
      "command": "web/node_modules/.bin/eslint --config web/eslint.config.js --no-warn-ignored --no-error-on-unmatched-pattern",
      "enabled": true,
      "scope": "changed"
    },
    {
      "id": "agent-responses-tests",
      "name": "Agent Responses and sibling adapter tests",
      "kind": "test",
      "command": "npm --prefix agent test -- __tests__/openaiResponses.test.ts harness/providers/__tests__/adapters.test.ts",
      "enabled": true,
      "scope": "repo"
    },
    {
      "id": "agent-typecheck",
      "name": "Agent TypeScript",
      "kind": "lint",
      "command": "npm --prefix agent run typecheck",
      "enabled": true,
      "scope": "repo"
    },
    {
      "id": "python-tests",
      "name": "Python Tests",
      "kind": "test",
      "command": "bash scripts/check.sh test-python",
      "enabled": true,
      "scope": "repo"
    },
    {
      "id": "web-ui-tests",
      "name": "Web UI tests",
      "kind": "test",
      "command": "bash scripts/check.sh test-web",
      "enabled": true,
      "scope": "repo"
    },
    {
      "id": "agent-tests",
      "name": "Agent tests",
      "kind": "test",
      "command": "bash scripts/check.sh test-agent",
      "enabled": true,
      "scope": "repo"
    }
  ]
}
