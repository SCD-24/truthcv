{
  "version": 2,
  "checks": [
    {
      "id": "agent-responses-tests",
      "name": "Agent Responses and sibling adapter tests",
      "kind": "test",
      "command": "npm --prefix agent test -- __tests__/openaiResponses.test.ts harness/providers/__tests__/adapters.test.ts",
      "enabled": true,
      "scope": "repo"
    },
    {
      "id": "agent-typecheck",
      "name": "Agent TypeScript",
      "kind": "lint",
      "command": "npm --prefix agent run typecheck",
      "enabled": true,
      "scope": "repo"
    },
    {
      "id": "lint",
      "name": "Typecheck (web + agent)",
      "kind": "lint",
      "command": "bash scripts/check.sh lint",
      "enabled": true,
      "scope": "repo"
    },
    {
      "id": "python-tests",
      "name": "Python Tests",
      "kind": "test",
      "command": "bash scripts/check.sh test-python",
      "enabled": true,
      "scope": "repo"
    },
    {
      "id": "web-ui-tests",
      "name": "Web UI tests",
      "kind": "test",
      "command": "bash scripts/check.sh test-web",
      "enabled": true,
      "scope": "repo"
    },
    {
      "id": "agent-tests",
      "name": "Agent tests",
      "kind": "test",
      "command": "bash scripts/check.sh test-agent",
      "enabled": true,
      "scope": "repo"
    }
  ]
}
