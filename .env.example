# Which LLM provider the provider layer selects: anthropic | openai | ollama
LLM_PROVIDER=anthropic

# Optional explicit model id; each provider has a sensible default if blank.
LLM_MODEL=

# Credentials — set the one matching LLM_PROVIDER.
# These are fallback values; provider accounts can also be configured on the in-app
# Model routing page (encrypted at rest, available when ENCRYPTION_KEY is set).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Master key that encrypts saved provider API keys (./data/secrets.enc).
# Generate one with (no dependencies needed):
#   python -c "import secrets,base64; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
# Without a valid key, saved credentials cannot be written or read, and
# credentials fall back to the environment variables above.
ENCRYPTION_KEY=

# Ollama host (used when LLM_PROVIDER=ollama). Compose defaults it to
# http://ollama:11434. Outside Docker the provider defaults to localhost when
# the variable is absent. Leave it commented out: an uncommented localhost value
# breaks the Compose ollama profile, pointing the app container at itself.
# OLLAMA_HOST=http://localhost:11434

# Gmail OAuth client credentials (connections/auth/gmail.py). Unset leaves
# the Gmail connection reporting "Google OAuth is not configured on the
# server."
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Set to the exact registered redirect URI when serving behind a reverse
# proxy, e.g. https://truthcv.home.arpa/api/auth/gmail/callback.
GOOGLE_OAUTH_REDIRECT_URI=

# Where truth.yaml and generated CVs are persisted.
DATA_DIR=./data

# Runaway backstop on harness turns per application session. Matches the
# defaults in docker-compose.yml (${AGENT_MAX_TURNS:-400}) and agent/daily-apply.sh.
# The operational bound is the Agents page's max-applications-per-run setting.
AGENT_MAX_TURNS=400

# Cap on consecutive retryable-error retries within one turn.
AGENT_MAX_RETRIES=12

# Ceiling on a single retry's backoff delay, in ms (5 minutes).
AGENT_MAX_RETRY_DELAY_MS=300000

# Cap on a single MCP tool result's characters before it is inserted into the
# conversation (a full-page browser snapshot, a long read); truncated with an
# explicit marker naming how many characters were cut.
AGENT_MAX_TOOL_RESULT_CHARS=24000

# On/off switch for Anthropic prompt-cache cache_control breakpoints. Set false
# as an escape hatch if turns are spaced further apart than the cache's 5-minute
# TTL, where cache writes (1.25x cost) could exceed the savings. Anthropic wire
# only; no effect on the OpenAI-compatible wire.
AGENT_PROMPT_CACHE=true

# REQUIRED. Shared secret the agent, app and browser containers authenticate
# to each other with; generate one with:
#
#     openssl rand -hex 32
#
# Leave it empty and every scheduled run aborts: the browser container's
# session control server rejects an empty token, and the run refuses to
# start rather than take a browser an attended sign-in session may hold.
# The agent also uses it to fetch its model credentials from the app's
# Application agent route (Model routing page).
AGENT_API_TOKEN=

# Optional bearer token guarding the read-only /mcp/diagnostics MCP endpoint
# (api/diagnostics_mcp.py). Unset/empty (the default) disables the endpoint
# entirely — every request to it returns 404. Generate with:
#
#     openssl rand -hex 32
DIAGNOSTICS_MCP_TOKEN=
