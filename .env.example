# Which LLM provider the provider layer selects: anthropic | openai | ollama
LLM_PROVIDER=anthropic

# Optional explicit model id; each provider has a sensible default if blank.
LLM_MODEL=

# Credentials — set the one matching LLM_PROVIDER.
# These are fallback values; provider accounts can also be configured in the in-app
# Settings → Accounts modal (encrypted at rest, available when ENCRYPTION_KEY is set).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Master key that encrypts saved provider API keys (./data/secrets.enc).
# Generate one with (no dependencies needed):
#   python -c "import secrets,base64; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
# If unset, the Settings feature is disabled and credentials come from the vars above.
ENCRYPTION_KEY=

# Ollama host (used when LLM_PROVIDER=ollama; compose sets this to the ollama service).
OLLAMA_HOST=http://localhost:11434

# Where truth.yaml and generated CVs are persisted.
DATA_DIR=./data

# Unattended agent (agent/harness/) credentials — provider-neutral, distinct
# from the wizard's ANTHROPIC_API_KEY/LLM_PROVIDER above. These are only the
# container-level fallback; the primary source is GET /api/agent/llm-credentials,
# read via the connection configured in Settings → Accounts.
AGENT_LLM_PROVIDER=
AGENT_LLM_MODEL=
AGENT_LLM_API_KEY=
AGENT_LLM_BASE_URL=
# 'oauth' | 'api_key' | 'url' — only needed if AGENT_LLM_PROVIDER=claude via
# an oauth subscription; leave empty otherwise.
AGENT_LLM_AUTH_TYPE=

# Hard cap on harness turns per unattended run (agent/harness/loop.ts).
AGENT_MAX_TURNS=40

# Cap on a single MCP tool result's characters before it is inserted into the
# conversation (a full-page browser snapshot, a long read); truncated with an
# explicit marker naming how many characters were cut.
AGENT_MAX_TOOL_RESULT_CHARS=24000

# On/off switch for Anthropic prompt-cache cache_control breakpoints. Set false
# as an escape hatch if turns are spaced further apart than the cache's 5-minute
# TTL, where cache writes (1.25x cost) could exceed the savings. Anthropic wire
# only; no effect on the OpenAI-compatible wire.
AGENT_PROMPT_CACHE=true

# REQUIRED. Shared secret the agent, app and browser containers authenticate
# to each other with; generate one with:
#
#     openssl rand -hex 32
#
# Leave it empty and every scheduled run aborts: the browser container's
# session control server rejects an empty token, and the run refuses to
# start rather than take a browser an attended sign-in session may hold.
AGENT_API_TOKEN=
